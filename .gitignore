# =============================================================
# Secrets and local configuration (RNF-08)
# Never commit real environment files, keys or credentials.
# =============================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.*
.aws/

# =============================================================
# Node.js / pnpm / Vite (apps/* and services/*)
# =============================================================
node_modules/
.pnpm-store/
dist/
dist-ssr/
*.local
*.tsbuildinfo
.vite/
.eslintcache
coverage/

# Test reports (Vitest, Playwright)
test-results/
playwright-report/
blob-report/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# pnpm manages the workspace; the API's npm lockfile is used by Docker.
package-lock.json
!services/api/package-lock.json
yarn.lock
bun.lock
bun.lockb

# =============================================================
# Python (standalone scripts)
# =============================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# =============================================================
# AWS SAM (infrastructure)
# samconfig.toml holds account-specific deploy settings; share
# samconfig.toml.example instead.
# =============================================================
.aws-sam/
samconfig.toml

# =============================================================
# Local databases
# Dumps can contain user data, including password hashes.
# =============================================================
*.dump
*.backup

# =============================================================
# Editors, tools and operating systems
# =============================================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/settings.local.json
.DS_Store
Thumbs.db
Desktop.ini
docs
