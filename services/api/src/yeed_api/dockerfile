# Elegimos una imagen ligera de Node.js 22 para
# reducir el tamaño y consumo de recursos.
FROM node:22-alpine

# Establecemos una carpeta fija para evitar
# problemas con las rutas de nuestra aplicación.
WORKDIR /app

# Copiamos primero los archivos de dependencias
# porque cambian menos que el código del proyecto.
COPY package*.json ./

# Instalamos versiones exactas para mantener
# el mismo entorno en todos los despliegues.
RUN npm ci

# Copiamos la configuración y el código después
# para aprovechar la caché de las dependencias.
COPY . .

# Compilamos TypeScript porque nuestra aplicación
# Express se ejecutará como JavaScript.
RUN npm run build

# Indicamos el puerto de la API para facilitar
# su configuración al desplegar el contenedor.
EXPOSE 3000

# Iniciamos Express utilizando el código compilado
# sin tener que compilar en cada ejecución.
CMD ["node", "dist/server.js"]

# Yeed necesita proteger información como la contraseña de PostgreSQL, las claves de autenticación de usuarios y los permisos de acceso a servicios de AWS como DynamoDB y S3.
# Estos datos no se guardarán dentro del Dockerfile ni de la imagen. Utilizaremos variables de entorno y AWS Secrets Manager para proporcionar las credenciales al ejecutar el contenedor. Para comunicarnos con servicios de AWS utilizaremos roles IAM, evitando almacenar claves de acceso en el código.
# También utilizaremos un archivo .dockerignore para impedir que archivos sensibles, como .env, se incluyan accidentalmente en la imagen.